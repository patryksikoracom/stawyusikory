NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
SMSAPI_TOKEN=
# Domyślnie wyłączone. Ustaw true dopiero po przejściu bramki wysyłki opisanej w ADR-001.
STAWY_OS_SMS_ENABLED=false

# Resend. Konto Resend nie musi używać tego samego adresu co nadawca.
# Przed włączeniem zweryfikuj domenę stawyusikory.pl (SPF + DKIM) w Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=rezerwacja@stawyusikory.pl
RESEND_FROM_NAME=Stawy u Sikory
RESEND_REPLY_TO=marcin@stawyusikory.pl
RESEND_WEBHOOK_SECRET=
# Twardy kill switch; API key sam nie uruchamia automatycznej wysyłki.
STAWY_OS_EMAIL_ENABLED=false
# Bufor poniżej bezpłatnego limitu 100 wiadomości / 24 h.
STAWY_OS_EMAIL_DAILY_LIMIT=80

# Local administration only. Never configure these in Vercel.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
